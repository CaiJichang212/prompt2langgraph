#!/bin/sh
set -eu

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

export UV_CACHE_DIR="${UV_CACHE_DIR:-${TMPDIR:-/tmp}/prompt2langgraph-uv-cache}"

run_project_tool() {
  tool_name="$1"
  shift
  if [ -x ".venv/bin/$tool_name" ]; then
    ".venv/bin/$tool_name" "$@"
    return
  fi
  uv run "$tool_name" "$@"
}

echo "pre-push: ruff check"
run_project_tool ruff check src tests scripts

echo "pre-push: ruff format check"
run_project_tool ruff format --check src tests scripts

echo "pre-push: pytest"
run_project_tool pytest
