      {"id": "neg_schema_fanout_reducer", "test_file": "invalid/fanout_without_reducer.json", "expected_error": "E_REDUCER_012", "expected_error_message": "fanout requires reducer for result state key", "test_category": "schema_negative"},
      {"id": "neg_schema_join_sources", "test_file": "invalid/join_without_sources.json", "expected_error": "E_JOIN_001", "expected_error_message": "join edge must declare join_sources", "test_category": "schema_negative"},
      {"id": "neg_schema_loop_guard", "test_file": "invalid/loop_without_guard.json", "expected_error": "E_LOOP_005", "expected_error_message": "loop edge must have loop_guard.max_iterations", "test_category": "schema_negative"},
      {"id": "neg_registry_executor", "test_file": "invalid/node_executor_not_registered.json", "expected_error": "E_BIND_006", "expected_error_message": "executor ref not found in registry", "test_category": "registry_negative"},
      {"id": "neg_skill_frontmatter_json", "test_file": "invalid/skill_no_frontmatter.json", "expected_error": "E_SCHEMA_002", "expected_error_message": "frontmatter missing name or description", "test_category": "skill_negative"},
