      {"id": "neg_security_model_whitelist", "test_file": "invalid/security_model_not_in_whitelist.json", "expected_error": "E_SEC_014", "expected_error_message": "model not in allowed_models whitelist", "test_category": "security_negative"},
      {"id": "neg_security_tool_registered", "test_file": "invalid/security_tool_not_registered.json", "expected_error": "E_SEC_015", "expected_error_message": "tool ref not in allowed_tool_refs or not registered", "test_category": "security_negative"},
