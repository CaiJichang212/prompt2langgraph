    "id": "requirements_conditional_human_gate",
    "prompt_source": "prompts/upstream-requirements-engineering-expert.md",
    "expected_valid": true,
    "plan": {
      "name": "Requirements Conditional Human Gate",
      "entrypoint": "route_confidence",
      "inputs": {
        "question": "string",
        "confidence": "number"
      },
      "outputs": {
        "answer": "string"
      },
      "nodes": [
        {
          "id": "route_confidence",
          "kind": "router",
          "executor": "builtin.route"
        },
        {
          "id": "approval",
          "kind": "human_gate",
          "executor": "builtin.human_gate",
          "outputs": {
            "approval": "approval"
          },
          "params": {
            "message": "Approve low-confidence requirements summary?"
          }
        },
        {
          "id": "write_requirements",
          "kind": "llm",
          "executor": "builtin.echo_llm",
          "inputs": {
            "question": "question"
          },
          "outputs": {
            "answer": "answer"
          },
          "params": {
            "template": "Write requirements from stakeholder request: {question}"
          }
        }
      ],
      "edges": [
        {
          "from": "route_confidence",
          "to": "write_requirements",
          "kind": "conditional",
          "condition": {
            "expr": "confidence < 0.75",
            "routes": {
              "true": "approval",
              "false": "write_requirements"
            }
          }
        },
        {
          "from": "approval",
          "to": "write_requirements"
        }
      ]
    }
  },
